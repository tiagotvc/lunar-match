* text=auto eol=lf

*.cs diff=csharp text
*.cginc text
*.shader text
*.hlsl text
*.compute text
# Unity YAML assets (Force Text serialization) - merge with Unity's tool, lock scenes/prefabs to avoid unmergeable conflicts
*.unity merge=unityyamlmerge eol=lf text lockable
*.prefab merge=unityyamlmerge eol=lf text lockable
*.asset merge=unityyamlmerge eol=lf text
*.mat merge=unityyamlmerge eol=lf text
*.anim merge=unityyamlmerge eol=lf text
*.controller merge=unityyamlmerge eol=lf text
*.physicsMaterial2D merge=unityyamlmerge eol=lf text
*.physicMaterial merge=unityyamlmerge eol=lf text
*.playable merge=unityyamlmerge eol=lf text
*.mixer merge=unityyamlmerge eol=lf text
*.shadergraph merge=unityyamlmerge eol=lf text
*.meta merge=unityyamlmerge eol=lf text
